go_data <- data.frame(
ONTOLOGY = c("MF", "BP", "CC"),
Term = c("DNA binding",
"DNA replication",
"gamma DNA polymerase complex"),
Count = c(1, 1, 1)
)
go_data$Term <- factor(go_data$Term, levels = rev(go_data$Term))
ggplot(go_data, aes(x = Term, y = Count, fill = ONTOLOGY)) +
geom_col(width = 0.8) +
geom_text(aes(label = Count), hjust = -0.2, size = 4) +
coord_flip() +
facet_wrap(~ONTOLOGY, scales = "free_y") +
labs(title = "GO Terms for P54098", x = NULL, y = "Count") +
ylim(0, 1.2) +
theme_minimal(base_size = 13) +
theme(
legend.position = "bottom",
strip.text = element_text(face = "bold"),
plot.title = element_text(face = "bold", hjust = 0.5)
)
