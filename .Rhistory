library(ggplot2)
go_data <- data.frame(
ONTOLOGY = c("MF", "BP", "CC"),
Term = c("DNA binding",
"DNA replication",
"gamma DNA polymerase complex"),
Count = c(1, 1, 1)
)
ggplot(go_data, aes(x = Term, y = Count, fill = ONTOLOGY)) +
geom_col() +
geom_text(aes(label = Count), hjust = -0.2) +
coord_flip() +
facet_wrap(~ONTOLOGY, scales = "free_y") +
labs(title = "GO Terms for P54098", x = NULL, y = "Count") +
theme_minimal() +
theme(legend.position = "bottom")
go_data <- data.frame(
ONTOLOGY = c("MF", "BP", "CC"),
Term = c("DNA binding",
"DNA replication",
"gamma DNA polymerase complex"),
